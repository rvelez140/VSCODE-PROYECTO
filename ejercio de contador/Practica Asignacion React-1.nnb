            ],
            "outputs": []
        },
        {
            "language": "javascript",
            "source": [
                "// Paso 1. Importa useState or useReducer desde React. \r\n\r\nfunction MultiCounter() {\r\n    // Paso 2: crear estado contador\r\n    // Paso 3: botones para incrementar, decrementar y reiniciar\r\n  \r\n    return (\r\n      <div style={{ padding: \"2rem\" }}>\r\n        <h2>Contador:</h2>\r\n        {/* Botones para controlar contador */}\r\n      </div>\r\n    );\r\n  }"
            ],
