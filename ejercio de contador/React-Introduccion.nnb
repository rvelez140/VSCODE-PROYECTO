        },
        {
            "language": "javascript",
            "source": [
                "import TemaContext from './TemaContext';\r\n\r\nfunction App() {\r\n  const [tema, setTema] = useState('claro');\r\n\r\n  return (\r\n    <TemaContext.Provider value={{ tema, setTema }}>\r\n      <Contenido />\r\n    </TemaContext.Provider>\r\n  );\r\n}"
            ],
            "outputs": []
        },
        {
            "language": "markdown",
