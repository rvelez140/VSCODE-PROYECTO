        {
            "language": "javascript",
            "source": [
                "const items = ['Elemento 1', 'Elemento 2'];\r\n\r\n<ul>\r\n  {items.map((item, index) => (\r\n    <li key={index}>{item}</li>\r\n  ))}\r\n</ul>"
            ],
            "outputs": []
