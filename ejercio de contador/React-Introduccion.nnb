            ],
            "outputs": []
        },
        {
            "language": "markdown",
            "source": [
                "##### 9.2 Trabajo con Directivas Estructurales \r\n \r\n- **Renderizado Condicional** :"
            ],
            "outputs": []
        },
        {
            "language": "javascript",
            "source": [
                "{usuarioLogueado ? <Dashboard /> : <Login />}"
            ],
            "outputs": []
        },
        {
            "language": "markdown",
            "source": [
                "**Ejemplo Completo**"
            ],
            "outputs": []
        },
        {
            "language": "javascript",
            "source": [
                "import React, { useState } from 'react';"
            ],
            "outputs": []
        },
        {
            "language": "javascript",
            "source": [
                "// Componente que representa el Dashboard cuando el usuario está logueado\r\nfunction Dashboard() {\r\n  return (\r\n    <div>\r\n      <h1>Bienvenido al Dashboard</h1>\r\n      <p>Esta es la vista principal para usuarios logueados.</p>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Dashboard;"
            ],
            "outputs": []
        },
        {
            "language": "javascript",
            "source": [
                "// Componente que representa el Login cuando el usuario no está logueado\r\nfunction Login({ iniciarSesion }) {\r\n    return (\r\n        <div>\r\n            <h1>Inicia sesión</h1>\r\n            <button onClick={iniciarSesion}>Iniciar sesión</button>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default Login;"
            ],
            "outputs": []
        },
        {
            "language": "javascript",
            "source": [
                "// Componente principal que muestra ya sea el Dashboard o la vista de Login\r\nfunction App() {\r\n  const [usuarioLogueado, setUsuarioLogueado] = useState(false);\r\n\r\n  // Función para iniciar sesión\r\n  const iniciarSesion = () => {\r\n    setUsuarioLogueado(true);\r\n  };\r\n\r\n  // Función para cerrar sesión\r\n  const cerrarSesion = () => {\r\n    setUsuarioLogueado(false);\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      {/* Renderizado condicional: Si está logueado, muestra Dashboard; si no, muestra Login */}\r\n      {usuarioLogueado ? (\r\n        <div>\r\n          <Dashboard />\r\n          <button onClick={cerrarSesion}>Cerrar sesión</button>\r\n        </div>\r\n      ) : (\r\n        <Login iniciarSesion={iniciarSesion} />\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default App;"
            ],
            "outputs": []
        },
        {
            "language": "markdown",
            "source": [
                "- **Renderizado de Listas** :"
